############################################################################
#  KARGO HIRING: keys and config. Copy to .env.local for local development,
#  or add each value under Vercel → Project → Settings → Environment Variables.
#  .env* files are git-ignored. Never commit real keys.
############################################################################

# ---- SUPABASE (server only) ----
SUPABASE_URL=
# Project Settings → API Keys → secret key (sb_secret_...) or legacy service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ---- GEMINI ----
GEMINI_API_KEY=
# Optional. Defaults shown.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# ---- LOGIN ----
# REQUIRED in production. Without it the dashboard stays locked.
APP_PASSWORD=
# Optional: signs session cookies (defaults to APP_PASSWORD).
AUTH_SECRET=

# ---- RESEND (email) ----
RESEND_API_KEY=
# Without a verified domain Resend can only send FROM onboarding@resend.dev
# and only TO the address you signed up with.
RESEND_FROM=Kargo Hiring <onboarding@resend.dev>
# For testing: redirect EVERY email to this address instead of the candidate.
EMAIL_OVERRIDE_TO=
# Optional: where candidate replies go.
REPLY_TO=
# Optional: enables the "Email me a summary" button.
ARJUN_EMAIL=
